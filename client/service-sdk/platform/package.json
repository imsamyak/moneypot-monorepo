{
  "name": "@moneypot/platform-sdk",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the MoneyPot platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "pnpm --filter @moneypot/sdk-core build",
    "build": "tsc -p tsconfig.build.json",
    "pretypecheck": "pnpm --filter @moneypot/sdk-core build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @moneypot/sdk-core build",
    "test": "vitest run"
  },
  "dependencies": {
    "@moneypot/sdk-core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
