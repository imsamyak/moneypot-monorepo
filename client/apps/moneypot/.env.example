# Where the services are. Leave them out for the local ports (identity 9086, wallet 9081, pot 9082).
# MONEYPOT_API_URL=http://localhost
# MONEYPOT_IDENTITY_URL=http://localhost:9086
# MONEYPOT_WALLET_URL=http://localhost:9081
# MONEYPOT_POT_URL=http://localhost:9082

# Where the browser opens the live connection of a pot (the pot service, as the browser sees it).
# Leave it out to use MONEYPOT_POT_URL with ws:// in place of http://.
# MONEYPOT_POT_WS_URL=ws://localhost:9082

# Set to false when the app is served over plain http outside development.
# COOKIE_SECURE=true
