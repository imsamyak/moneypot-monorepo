<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.moneypot</groupId>
    <artifactId>moneypot-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>moneypot</name>
    <description>MoneyPot Service Monorepo</description>
    <packaging>pom</packaging>

    <modules>
        <!--modules-->
        <module>module/shared</module>
        <module>module/web</module>
        <module>module/security</module>
        <module>module/messaging</module>

        <!--infra-->
        <module>infra</module>

        <!--services-->
        <module>service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.moneypot</groupId>
                <artifactId>moneypot-platform-shared</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moneypot</groupId>
                <artifactId>moneypot-platform-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moneypot</groupId>
                <artifactId>moneypot-platform-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moneypot</groupId>
                <artifactId>moneypot-platform-outbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moneypot</groupId>
                <artifactId>moneypot-platform-inbox</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moneypot</groupId>
                <artifactId>moneypot-platform-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.moneypot</groupId>
                <artifactId>moneypot-platform-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openapitools</groupId>
                <artifactId>jackson-databind-nullable</artifactId>
                <version>0.2.11</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
