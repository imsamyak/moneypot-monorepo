# The web app, built on Linux inside the image (a bundle built on Windows loses the package links of pnpm).
# Context: this folder, with the workspace sources in websrc/ (deploy.sh puts them there).
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /src
COPY websrc/ ./
RUN pnpm install --frozen-lockfile --filter "@moneypot/web..."
RUN pnpm --filter @moneypot/web build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /src/client/apps/moneypot/.next/standalone ./
COPY --from=build /src/client/apps/moneypot/.next/static ./client/apps/moneypot/.next/static
ENV NODE_ENV=production PORT=3100 HOSTNAME=0.0.0.0
EXPOSE 3100
CMD ["node", "client/apps/moneypot/server.js"]
